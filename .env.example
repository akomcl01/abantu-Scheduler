# Firebase (optional). Without these the app runs in local mode, saved on the device only.
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional. Defaults to <project-id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
# The shared editor account. Its password is the group PIN. Must match the email in firestore.rules.
VITE_FIREBASE_EDITOR_EMAIL=abantu-editor@abantu.app
